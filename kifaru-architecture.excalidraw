      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Banks submit suspected fraud from their own detection systems. Kifaru validates centrally, then either alerts the receiving bank or marks the report as not fraud.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Banks submit suspected fraud from their own detection systems. Kifaru validates centrally, then either alerts the receiving bank or marks the report as not fraud.",
      "lineHeight": 1.25
    },
